#! /usr/bin/env python
# encoding: utf-8

from waflib import Utils
import os

top = '.'
PROJECT_NAME = 'togl'

def options(opt):
	# stub
	return

def configure(conf):
	conf.define('TOGL_DLL_EXPORT',1)
	conf.env.append_unique('DEFINES',['strncpy=use_Q_strncpy_instead',
		'_snprintf=use_Q_snprintf_instead'])

def build(bld):
	source = [
		'linuxwin/dx9asmtogl2.cpp',
		'linuxwin/dxabstract.cpp',
		'linuxwin/glentrypoints.cpp',	
		'linuxwin/glmgr.cpp',			
		'linuxwin/glmgrbasics.cpp',	
		#'linuxwin/intelglmallocworkaround.cpp',		[$OSXALL]
		#'linuxwin/mach_override.c',					[$OSXALL]
		'linuxwin/cglmtex.cpp',		
		'linuxwin/cglmfbo.cpp',		
		'linuxwin/cglmprogram.cpp',	
		'linuxwin/cglmbuffer.cpp',	
		'linuxwin/cglmquery.cpp',
		'linuxwin/asanstubs.cpp',
		'linuxwin/decompress.c'
	]

	if bld.env.DEST_OS == "darwin":
		source += ['linuxwin/glmgrcocoa.mm']

	includes = [
		'.',
		'../public',
		'../public/tier0',
		'../public/tier1'
	] + bld.env.INCLUDES_SDL2

	defines = [
		# Disable GL batch perf analysis call timers (removes GL_BATCH_PERF_CALL_TIMER overhead)
		'GL_BATCH_PERF_ANALYSIS=0',
	]
	gl_libs = ['GLESv2','EGL','tier0','tier1','tier2','vstdlib','mathlib']
	if bld.env.DEST_CPU in ['arm','aarch64']:
		# Mali TBDR: skip glFlush() in BeginFrame — Mali batches commands internally
		# and syncs at natural boundaries (frame present). Mid-frame flush forces
		# an early tile resolve, wasting GPU time on an in-order pipeline.
		defines += ['GL_SKIP_TOF_FLUSH']

	libs = gl_libs

	if bld.env.DEST_OS == "darwin":
		libs += ["OPENGL", "CARBON"]

	install_path = bld.env.LIBDIR

	# Apply LTO only to the togles library (not the whole engine).
	# The critical per-draw call chain (dxabstract.cpp -> glmgr.cpp's
	# FlushDrawStates -> glmgr.h inline state setters -> GLContextSet)
	# is entirely within this library.  LTO here lets GCC inline the
	# cross-.o calls (e.g. DrawIndexedPrimitive -> FlushDrawStates),
	# eliminating function-call overhead on the A35's in-order pipeline.
	# Global --enable-lto OOMs on 1-2GB RAM devices because the engine
	# is huge; togles alone is small enough to fit.
	togl_cflags = []
	togl_linkflags = []
	if bld.env.DEST_CPU in ['arm', 'aarch64'] and bld.env.COMPILER_CC != 'msvc':
		togl_cflags = ['-flto']
		togl_linkflags = ['-flto']

	bld.shlib(
		source   = source,
		target   = PROJECT_NAME,
		name     = PROJECT_NAME,
		features = 'c cxx',
		includes = includes,
		defines  = defines,
		use      = libs,
		install_path = install_path,
		subsystem = bld.env.MSVC_SUBSYSTEM,
		cflags   = togl_cflags,
		linkflags = togl_linkflags,
		idx      = bld.get_taskgen_count()
	)

